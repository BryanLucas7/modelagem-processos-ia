<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_Analitico" targetNamespace="http://example.com/modelagem-processos">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_Org" name="Organização" processRef="Process_Analitico"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Analitico" name="Processo analítico" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Atendente" name="Atendente">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Concluir</bpmn:flowNodeRef><bpmn:flowNodeRef>End_OK</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analista" name="Analista">
        <bpmn:flowNodeRef>Task_Analisar</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Decisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Aprovar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Rejeitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Solicitação recebida"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_Registrar" name="Registrar solicitação"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Analisar" name="Analisar solicitação"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Decisao" name="Solicitação válida?"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Aprovar" name="Aprovar solicitação"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Rejeitar" name="Rejeitar solicitação"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Merge"><bpmn:incoming>F6</bpmn:incoming><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Concluir" name="Registrar resultado"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_OK" name="Processo encerrado"><bpmn:incoming>F9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Registrar"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Registrar" targetRef="Task_Analisar"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Analisar" targetRef="Gateway_Decisao"/>
    <bpmn:sequenceFlow id="F4" name="Sim" sourceRef="Gateway_Decisao" targetRef="Task_Aprovar"/>
    <bpmn:sequenceFlow id="F5" name="Não" sourceRef="Gateway_Decisao" targetRef="Task_Rejeitar"/>
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Aprovar" targetRef="Gateway_Merge"/>
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Rejeitar" targetRef="Gateway_Merge"/>
    <bpmn:sequenceFlow id="F8" sourceRef="Gateway_Merge" targetRef="Task_Concluir"/>
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Concluir" targetRef="End_OK"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_2"><bpmndi:BPMNPlane id="Plane_2" bpmnElement="Collab_1">
    <bpmndi:BPMNShape id="Participant_di" bpmnElement="Participant_Org" isHorizontal="true"><dc:Bounds x="80" y="80" width="1080" height="360"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Atendente_di" bpmnElement="Lane_Atendente" isHorizontal="true"><dc:Bounds x="110" y="80" width="1050" height="180"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Analista_di" bpmnElement="Lane_Analista" isHorizontal="true"><dc:Bounds x="110" y="260" width="1050" height="180"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Start_di" bpmnElement="Start_1"><dc:Bounds x="150" y="142" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Reg_di" bpmnElement="Task_Registrar"><dc:Bounds x="230" y="120" width="120" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Ana_di" bpmnElement="Task_Analisar"><dc:Bounds x="400" y="300" width="120" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Dec_di" bpmnElement="Gateway_Decisao" isMarkerVisible="true"><dc:Bounds x="570" y="315" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Apr_di" bpmnElement="Task_Aprovar"><dc:Bounds x="670" y="270" width="120" height="70"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Rej_di" bpmnElement="Task_Rejeitar"><dc:Bounds x="670" y="365" width="120" height="70"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true"><dc:Bounds x="840" y="315" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Conc_di" bpmnElement="Task_Concluir"><dc:Bounds x="930" y="120" width="120" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_di" bpmnElement="End_OK"><dc:Bounds x="1090" y="142" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="186" y="160"/><di:waypoint x="230" y="160"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="350" y="160"/><di:waypoint x="375" y="160"/><di:waypoint x="375" y="340"/><di:waypoint x="400" y="340"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="520" y="340"/><di:waypoint x="570" y="340"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="620" y="340"/><di:waypoint x="645" y="340"/><di:waypoint x="645" y="305"/><di:waypoint x="670" y="305"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="595" y="365"/><di:waypoint x="595" y="400"/><di:waypoint x="670" y="400"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="790" y="305"/><di:waypoint x="815" y="305"/><di:waypoint x="815" y="340"/><di:waypoint x="840" y="340"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="790" y="400"/><di:waypoint x="815" y="400"/><di:waypoint x="815" y="340"/><di:waypoint x="840" y="340"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="890" y="340"/><di:waypoint x="910" y="340"/><di:waypoint x="910" y="160"/><di:waypoint x="930" y="160"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1050" y="160"/><di:waypoint x="1090" y="160"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
