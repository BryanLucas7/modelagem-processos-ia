<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Colab" targetNamespace="http://example.com/modelagem-processos" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:message id="Message_Solicitacao" name="Solicitação" />
  <bpmn:message id="Message_Resposta" name="Resposta" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_A" name="Participante A" processRef="Process_A" />
    <bpmn:participant id="Participant_B" name="Participante B" processRef="Process_B" />
    <bpmn:messageFlow id="MF_1" name="Solicitação" sourceRef="Throw_A" targetRef="Start_B" />
    <bpmn:messageFlow id="MF_2" name="Resposta" sourceRef="Throw_B" targetRef="Catch_A" />
  </bpmn:collaboration>
  <bpmn:process id="Process_A" name="Processo A" isExecutable="false">
    <bpmn:startEvent id="Start_A" name="Necessidade identificada">
      <bpmn:outgoing>A1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Preparar" name="Preparar solicitação">
      <bpmn:incoming>A1</bpmn:incoming>
      <bpmn:outgoing>A2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="Throw_A" name="Enviar solicitação">
      <bpmn:incoming>A2</bpmn:incoming>
      <bpmn:outgoing>A3</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Solicitacao" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Catch_A" name="Receber resposta">
      <bpmn:incoming>A3</bpmn:incoming>
      <bpmn:outgoing>A4</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Resposta" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_Avaliar" name="Avaliar resposta">
      <bpmn:incoming>A4</bpmn:incoming>
      <bpmn:outgoing>A5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_A" name="Atendimento concluído">
      <bpmn:incoming>A5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="A1" sourceRef="Start_A" targetRef="Task_Preparar" />
    <bpmn:sequenceFlow id="A2" sourceRef="Task_Preparar" targetRef="Throw_A" />
    <bpmn:sequenceFlow id="A3" sourceRef="Throw_A" targetRef="Catch_A" />
    <bpmn:sequenceFlow id="A4" sourceRef="Catch_A" targetRef="Task_Avaliar" />
    <bpmn:sequenceFlow id="A5" sourceRef="Task_Avaliar" targetRef="End_A" />
  </bpmn:process>
  <bpmn:process id="Process_B" name="Processo B" isExecutable="false">
    <bpmn:startEvent id="Start_B" name="Solicitação recebida">
      <bpmn:outgoing>B1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Solicitacao" />
    </bpmn:startEvent>
    <bpmn:task id="Task_Analisar_B" name="Analisar solicitação">
      <bpmn:incoming>B1</bpmn:incoming>
      <bpmn:outgoing>B2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="Throw_B" name="Enviar resposta">
      <bpmn:incoming>B2</bpmn:incoming>
      <bpmn:outgoing>B3</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Resposta" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_B" name="Atendimento encerrado">
      <bpmn:incoming>B3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="B1" sourceRef="Start_B" targetRef="Task_Analisar_B" />
    <bpmn:sequenceFlow id="B2" sourceRef="Task_Analisar_B" targetRef="Throw_B" />
    <bpmn:sequenceFlow id="B3" sourceRef="Throw_B" targetRef="End_B" />
  </bpmn:process>
