<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 id="Definitions_Timer" targetNamespace="http://example.com/modelagem-processos">
  <bpmn:process id="Process_Timer" name="Processo com SLA" isExecutable="false">
    <bpmn:startEvent id="Start_T" name="Caso recebido"><bpmn:outgoing>T1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_Analisar" name="Analisar caso"><bpmn:incoming>T1</bpmn:incoming><bpmn:outgoing>T2</bpmn:outgoing></bpmn:task>
    <bpmn:boundaryEvent id="Boundary_Timer" name="SLA excedido" attachedToRef="Task_Analisar" cancelActivity="true">
      <bpmn:outgoing>T3</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_Resolver" name="Registrar solução"><bpmn:incoming>T2</bpmn:incoming><bpmn:outgoing>T4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Escalar" name="Escalar atendimento"><bpmn:incoming>T3</bpmn:incoming><bpmn:outgoing>T5</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_OK_T" name="Caso resolvido"><bpmn:incoming>T4</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_SLA_T" name="Caso escalado"><bpmn:incoming>T5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="T1" sourceRef="Start_T" targetRef="Task_Analisar"/>
    <bpmn:sequenceFlow id="T2" sourceRef="Task_Analisar" targetRef="Task_Resolver"/>
    <bpmn:sequenceFlow id="T3" sourceRef="Boundary_Timer" targetRef="Task_Escalar"/>
    <bpmn:sequenceFlow id="T4" sourceRef="Task_Resolver" targetRef="End_OK_T"/>
    <bpmn:sequenceFlow id="T5" sourceRef="Task_Escalar" targetRef="End_SLA_T"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Timer"><bpmndi:BPMNPlane id="Plane_Timer" bpmnElement="Process_Timer">
    <bpmndi:BPMNShape id="ST_di" bpmnElement="Start_T"><dc:Bounds x="120" y="142" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="TA_di" bpmnElement="Task_Analisar"><dc:Bounds x="220" y="120" width="140" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="BT_di" bpmnElement="Boundary_Timer"><dc:Bounds x="324" y="182" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="TR_di" bpmnElement="Task_Resolver"><dc:Bounds x="440" y="120" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="TE_di" bpmnElement="Task_Escalar"><dc:Bounds x="440" y="260" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="EOK_di" bpmnElement="End_OK_T"><dc:Bounds x="650" y="142" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="ESLA_di" bpmnElement="End_SLA_T"><dc:Bounds x="650" y="282" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="T1_di" bpmnElement="T1"><di:waypoint x="156" y="160"/><di:waypoint x="220" y="160"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="T2_di" bpmnElement="T2"><di:waypoint x="360" y="160"/><di:waypoint x="440" y="160"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="T3_di" bpmnElement="T3"><di:waypoint x="342" y="218"/><di:waypoint x="342" y="300"/><di:waypoint x="440" y="300"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="T4_di" bpmnElement="T4"><di:waypoint x="570" y="160"/><di:waypoint x="650" y="160"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="T5_di" bpmnElement="T5"><di:waypoint x="570" y="300"/><di:waypoint x="650" y="300"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
